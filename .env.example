# DueProof — Firebase web app configuration template.
#
# Copy this file to `.env.local` (git-ignored) and fill in the values for your
# Firebase project: Firebase console → Project settings → General →
# Your apps → SDK setup and configuration (Config).
#
# These values identify a Firebase web app inside client-side code; they are
# embedded in every Firebase-backed web app and are not secrets. Real access
# control comes from App Check, security rules, and API quotas.
#
# `measurementId` is intentionally omitted: DueProof never imports
# `firebase/analytics`.
#
# Note: Vite loads env files at startup — restart `npm run dev` after changes.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Reserved for the deployment phase (production App Check attestation provider):
# VITE_APP_CHECK_RECAPTCHA_ENTERPRISE_KEY=
